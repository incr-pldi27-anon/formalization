import Incr.Incr.Soundness.Statements
import Incr.IncrPP.Soundness.Statements

/-!
# Comparator challenge: the two paper soundness statements

The challenge is the trusted side of `lake comparator`. It restates the two
target theorems with `sorry` bodies, so it asserts the approved statement
without proving it. The solution side is the real library (`solution_module` is
`Incr`), which must prove the same statements, stay inside `permitted_axioms`,
and be accepted by an independent kernel replay.

The statements are the ones from `Incr.Incr.Soundness.Statements` and
`Incr.IncrPP.Soundness.Statements`. Those modules contain no proofs, so this
file does not import the live proof of either theorem.

Do not edit this file without re-reviewing the statements against the paper.
-/

open Incr
namespace Incr.Incr

variable {sig : Signature} {m : CommandModel sig} {h : Host sig}
  {prog : sig.Prog} {start : World sig}

/-- `thm:paper-sound` / `thm:main-sound`, statement only. -/
theorem thm_sound : SoundnessStatement m h prog start := by
  sorry

end Incr.Incr

namespace Incr.IncrPP

variable {sig : Signature}

/-- `thm:paper-live-sound` (E.12), statement only. -/
theorem thm_sound {m : CommandModel sig} {h : Host sig}
    {prog : sig.Prog} {start : World sig} : SoundnessStatement m h prog start := by
  sorry

end Incr.IncrPP
